{
  "name": "gate",
  "version": "1.0.0",
  "description": "Gate — event ticketing and offline door check-in platform",
  "scripts": {
    "dev": "yarn dev:api",
    "dev:api": "ts-node-dev -r tsconfig-paths/register --respawn ./src/index.ts",
    "dev:worker": "ts-node-dev -r tsconfig-paths/register --respawn ./src/worker.ts",
    "build": "rimraf dist && node scripts/setup.mjs make:certs ./src/core/.certs && tsc",
    "postbuild": "tsc-alias && node scripts/copy-assets.mjs",
    "prestart": "yarn setup",
    "start": "yarn start:api",
    "start:api": "NODE_ENV=production node ./dist/index.js",
    "start:worker": "NODE_ENV=production node ./dist/worker.js",
    "lint": "eslint --max-warnings 0 . && yarn tsc",
    "lint-fix": "eslint --fix .",
    "tsc": "tsc --noEmit",
    "format-lint": "prettier --config .prettierrc -l --ignore-unknown .",
    "format-fix": "prettier --config .prettierrc --write --ignore-unknown .",
    "pretest": "yarn setup:dev",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --require tsconfig-paths/register 'test/**/*.test.ts' --timeout 20000 --exit",
    "setup": "node scripts/setup.mjs make:certs ./dist/core/.certs",
    "setup:dev": "node scripts/setup.mjs make:certs ./src/core/.certs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.0.1",
    "bullmq": "^5.69.3",
    "cloudinary": "^1.30.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.2.1",
    "handlebars": "^4.7.7",
    "helmet": "^5.1.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.7.8",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "4.3.1",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.1.13",
    "typedi": "^0.10.0",
    "uuid": "^9.0.0",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/body-parser": "^1.19.2",
    "@types/chai": "^4.3.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/mocha": "9.1.1",
    "@types/morgan": "^1.9.3",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.11.18",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.14",
    "@types/uuid": "^9.0.1",
    "@types/validator": "^13.7.2",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "chai": "^4.3.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.15.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "mocha": "^9.2.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^2.6.2",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "ts-node": "10.7.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "license": "UNLICENSED"
}
