NODE_ENV=development
PORT=8000

DATABASE_URL=postgres://gate:gate@localhost:5432/gate

REDIS_CONNECTION_STRING=redis://localhost:6379

JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SALT=10

BACKEND_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# Cookie signing secret. Named for the removed device-auth scheme; App.ts passes it to
# cookie-parser. Rename to COOKIE_SECRET when Platform touches App.ts next.
DEVICE_JWT_SECRET=change-me

# Background reservation expiry sweep.
RESERVATION_EXPIRY_SWEEP_INTERVAL_MS=5000
RESERVATION_EXPIRY_BATCH_SIZE=100
RESERVATION_EXPIRY_MAX_EVENTS=10
PAYMENT_RECOVERY_SWEEP_INTERVAL_MS=5000
PAYMENT_RECOVERY_CLAIM_LEASE_SECONDS=30

# Ed25519 key pair used to sign ticket QR payloads, base64-encoded PEM.
# Generate with: yarn setup:ticket-keys
# PRIVATE_CHECKIN_KEY signs at issuance and must never leave the server.
# PUBLIC_CHECKIN_KEY is sent to door devices and is safe to expose.
# Regenerating this pair invalidates every ticket already issued.
PRIVATE_CHECKIN_KEY=
PUBLIC_CHECKIN_KEY=

# Cloudinary (event cover images, profile pictures)
CLOUD_NAME=
API_KEY=
API_SECRET=
